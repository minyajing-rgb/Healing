{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/minyajing-rgb/Healing/schemas/healing-entry.schema.json",
  "title": "Earth Healing Knowledge Entry",
  "type": "object",
  "required": ["id", "entity_type", "names", "status"],
  "properties": {
    "id": {"type":"string"},
    "entity_type": {
      "type":"string",
      "enum":["tradition","material","plant","fungus","mineral","animal_interaction","preparation","modality","text","person","place","institution","timeline_event","claim","media"]
    },
    "names": {
      "type":"object",
      "required":["zh","en"],
      "properties":{
        "zh":{"type":"string"},
        "en":{"type":"string"},
        "latin":{"type":["string","null"]},
        "local":{"type":"array","items":{"type":"object","properties":{"language":{"type":"string"},"name":{"type":"string"}}}}
      }
    },
    "summaries":{
      "type":"object",
      "properties":{"zh":{"type":"string"},"en":{"type":"string"}}
    },
    "traditions":{"type":"array","items":{"type":"string"}},
    "modalities":{"type":"array","items":{"type":"string"}},
    "materials":{"type":"array","items":{"type":"string"}},
    "preparations":{"type":"array","items":{"type":"string"}},
    "geography":{
      "type":"array",
      "items":{
        "type":"object",
        "required":["relationship","place_name"],
        "properties":{
          "relationship":{
            "type":"string",
            "enum":["origin_associated_with","historically_documented_in","living_practice_in","biological_distribution","cultivated_in","trade_route_through","research_institution_in","heritage_site_in"]
          },
          "place_name":{"type":"string"},
          "country_code":{"type":["string","null"]},
          "lat":{"type":["number","null"]},
          "lng":{"type":["number","null"]},
          "precision":{"type":"string","enum":["exact_public_site","city","region","country","approximate","withheld"]},
          "cultural_access":{"type":"string","enum":["open_public","attribution_required","community_context_required","restricted_detail","sacred_private","unknown"]}
        }
      }
    },
    "timeline":{
      "type":"array",
      "items":{
        "type":"object",
        "properties":{
          "date_start":{"type":["string","null"]},
          "date_end":{"type":["string","null"]},
          "date_precision":{"type":"string","enum":["exact","year","decade","century","approximate","unknown"]},
          "dating_note":{"type":["string","null"]},
          "contested":{"type":"boolean"},
          "event_id":{"type":["string","null"]}
        }
      }
    },
    "claims":{
      "type":"array",
      "items":{
        "type":"object",
        "required":["claim_id","claim_type","text_zh","text_en"],
        "properties":{
          "claim_id":{"type":"string"},
          "claim_type":{
            "type":"string",
            "enum":["historical_record","traditional_use","living_practice","mechanistic_hypothesis","preclinical","clinical_claim","subjective_wellbeing","cultural_symbolism","spiritual_metaphysical","commercial_claim"]
          },
          "text_zh":{"type":"string"},
          "text_en":{"type":"string"},
          "traditional_depth":{"type":["string","null"],"enum":["T0","T1","T2","T3",null]},
          "modern_evidence":{"type":["string","null"],"enum":["E0","E1","E2","E3","E4","E5",null]},
          "evidence_note":{"type":["string","null"]},
          "source_ids":{"type":"array","items":{"type":"string"}}
        }
      }
    },
    "safety":{
      "type":"object",
      "properties":{
        "routes":{"type":"array","items":{"type":"string"}},
        "risk_level":{"type":"string","enum":["unknown","low","moderate","high","professional_only"]},
        "contraindications":{"type":"array","items":{"type":"string"}},
        "interactions":{"type":"array","items":{"type":"string"}},
        "pregnancy_lactation":{"type":["string","null"]},
        "pediatric":{"type":["string","null"]},
        "allergy":{"type":["string","null"]},
        "toxicity":{"type":["string","null"]},
        "practitioner_requirement":{"type":["string","null"]},
        "emergency_red_flags":{"type":"array","items":{"type":"string"}}
      }
    },
    "conservation":{
      "type":"object",
      "properties":{
        "status":{"type":["string","null"]},
        "trade_restrictions":{"type":["string","null"]},
        "sustainability_note":{"type":["string","null"]}
      }
    },
    "cultural_rights":{
      "type":"object",
      "properties":{
        "access":{"type":"string","enum":["open_public","attribution_required","community_context_required","restricted_detail","sacred_private","unknown"]},
        "community":{"type":["string","null"]},
        "note":{"type":["string","null"]}
      }
    },
    "regulation":{
      "type":"array",
      "items":{
        "type":"object",
        "properties":{
          "jurisdiction":{"type":"string"},
          "status":{"type":"string"},
          "source_ids":{"type":"array","items":{"type":"string"}}
        }
      }
    },
    "media":{
      "type":"array",
      "items":{
        "type":"object",
        "properties":{
          "type":{"type":"string","enum":["image","botanical_plate","audio","video","3d","map","diagram","source_scan"]},
          "uri":{"type":"string"},
          "rights":{"type":["string","null"]},
          "status":{"type":"string","enum":["REFERENCE_ONLY","IMPORTED","VERIFIED","COMMITTED","PUBLISHED"]}
        }
      }
    },
    "sources":{
      "type":"array",
      "items":{
        "type":"object",
        "properties":{
          "source_id":{"type":"string"},
          "title":{"type":"string"},
          "url":{"type":["string","null"]},
          "source_type":{"type":"string"},
          "language":{"type":["string","null"]},
          "accessed_or_reviewed":{"type":["string","null"]}
        }
      }
    },
    "status":{
      "type":"string",
      "enum":["PLANNED","SOURCE_FOUND","EXTRACTED","STRUCTURED","REVIEWED","BILINGUAL","MAP_READY","TIMELINE_READY","PUBLISHED"]
    }
  }
}